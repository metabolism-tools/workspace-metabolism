{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/metabolism-tools/workspace-metabolism/main/schema/metabolism.schema.json",
  "title": "workspace-metabolism policy",
  "description": "One policy file controls the lifecycle of files in an AI-driven workspace.",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "ai_governance": {
      "type": "object",
      "properties": {
        "default": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_patterns": {
          "type": "object",
          "description": "Map MCP tool name patterns to AI actions (glob, e.g. \"fs_*\": \"write\"); used by wm gate.",
          "additionalProperties": {
            "enum": [
              "read",
              "write",
              "execute",
              "delete",
              "network"
            ]
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "allow": {
                "type": "boolean"
              },
              "requires_preview": {
                "type": "boolean"
              },
              "requires_approval": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "never_clean": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "recycle_retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "max_item_mb": {
          "type": "number",
          "minimum": 1
        },
        "disk_alert_free_gb": {
          "type": "number",
          "minimum": 0
        },
        "disk_alert_free_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dupe_scan_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "maintenance_tasks": {
      "type": "array",
      "maxItems": 128,
      "description": "Explicit maintenance executors and receipt locations. Configuration alone never establishes execution, permission or capability; doctor reads evidence without running commands.",
      "items": {
        "type": "object",
        "required": ["id", "scope", "policy_version", "executor", "required_actions", "required_capabilities", "capability_receipt", "execution_receipt", "max_age_seconds"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scope": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "policy_version": {"type": "string", "minLength": 1},
          "executor": {
            "type": "object",
            "required": ["id", "version", "description", "operation_action"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "operation_action": {"enum": ["clean", "slim", "retain", "rollback", "retain_restore", "purge"]}
            }
          },
          "required_actions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"enum": ["read", "write", "execute", "delete", "network"]}},
          "required_capabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "capability_receipt": {"type": "string", "minLength": 1},
          "execution_receipt": {"type": "string", "minLength": 1},
          "max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 31622400}
        }
      }
    },
    "consumer_checks": {
      "type": "array",
      "maxItems": 128,
      "description": "Named explicit consumer commands. Only the built-in read-only SQLite JSON export adapter is supported; doctor does not execute it.",
      "items": {
        "type": "object",
        "required": ["id", "version", "adapter", "adapter_version", "database", "relation", "id_column", "json_column", "fields"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "adapter": {"const": "sqlite_json_export_v1"},
          "adapter_version": {"const": "1"},
          "database": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "id_column": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "json_column": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "fields": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[^.]+$"}}
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "grade",
          "cleanup"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "description": "Unique SQLite resource name for wm db-check. Requires an exact relative file path, no glob or links."
          },
          "sqlite": {
            "type": "object",
            "required": [
              "required_tables"
            ],
            "additionalProperties": false,
            "properties": {
              "required_tables": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          "grade": {
            "enum": [
              "G1",
              "G2",
              "G3",
              "G4"
            ]
          },
          "cleanup": {
            "enum": [
              "never",
              "auto",
              "approve"
            ]
          },
          "retention_days": {
            "type": "integer",
            "minimum": 1
          },
          "scope": {
            "enum": [
              "files_only"
            ]
          },
          "protected": {
            "type": "boolean"
          },
          "remote_authoritative": {
            "type": "boolean"
          },
          "category": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "review_after": {
            "type": "string"
          },
          "db_slim": {
            "type": "object",
            "description": "In-place SQLite trimming policy for wm slim (table/blob column/keys to strip/keep-recent/vacuum threshold)",
            "properties": {
              "table": {
                "type": "string"
              },
              "blob_column": {
                "type": "string"
              },
              "strip_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keep_recent": {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "string"
                  },
                  "column": {
                    "type": "string"
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "key_column": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "row_column": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "required": [
                  "table",
                  "column",
                  "n"
                ],
                "dependentRequired": {
                  "key_column": [
                    "row_column"
                  ],
                  "row_column": [
                    "key_column"
                  ]
                }
              },
              "vacuum_min_gb": {
                "type": "number",
                "minimum": 0
              },
              "protected_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "db_retain": {
            "type": "object",
            "description": "Whole-row SQLite retention. All declared in-table JSON references protect their targets; backups have no automatic expiry.",
            "required": [
              "table",
              "blob_column",
              "id_column",
              "group_by",
              "reference_paths"
            ],
            "properties": {
              "table": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "blob_column": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "id_column": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "order_column": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "group_by": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reference_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "keep": {
                "type": "integer",
                "minimum": 1,
                "default": 2
              },
              "blob_encoding": {
                "enum": [
                  "auto",
                  "json",
                  "gzip"
                ],
                "default": "auto"
              },
              "verify_sha256": {
                "type": "boolean",
                "default": false
              },
              "max_rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000,
                "default": 1000000
              },
              "max_scan_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 536870912,
                "default": 536870912
              },
              "max_row_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432,
                "default": 33554432
              },
              "max_export_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864,
                "default": 67108864
              },
              "seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120,
                "default": 120
              }
            }
          }
        },
        "dependentRequired": {
          "resource_id": [
            "sqlite"
          ],
          "sqlite": [
            "resource_id"
          ]
        }
      }
    }
  }
}
